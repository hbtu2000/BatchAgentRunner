// ============================================================================
// BatchAgentRunner 运行配置模板（全字段 + 全默认值 + 逐项说明）
// ----------------------------------------------------------------------------
// 用法：复制本文件到 %LOCALAPPDATA%\BatchAgentRunner\config.json 后按需修改。
//       程序读取配置时允许 // 注释与尾随逗号；但在界面点「保存配置」会重写文件、
//       注释会丢失，所以注释版只作参考，长期修改建议配合 docs/CONFIG-配置项说明.md。
//
// 约定：字段名全部小写下划线；枚举用字符串；未列出的字段会被忽略（前向兼容）。
// 改完保存后：账号/模型/时段/冷却等调度相关项需「重建引擎」才生效（配置页保存按钮已自动做）。
// ============================================================================

{
  // ==========================================================================
  // ① 任务文件与执行工具
  // ==========================================================================

  // 必填。任务清单文件，支持两种格式：
  //   .json —— 原地原子回写状态与结果（结果直接写回本文件）
  //   .md   —— 只读输入，状态/结果写入同目录 sidecar 文件 <name>.md.result.json
  // 运行日志写在任务文件同目录的 runs/ 子目录；汇总报告 report-<时间戳>.json/.md 也写在同目录。
  "task_file_path": "E:/Src/CodeBak/WorkAgent/samples/tasks.json",

  // 执行工具，决定用哪个适配器去拉起 CLI 子进程：
  //   WorkBuddy —— 调 WorkBuddy CLI（默认）
  //   CodeBuddy —— 调 CodeBuddy CLI
  //   Mock      —— 内置仿真适配器，不调任何 CLI。想先跑通全流程 /验证降级与等待逻辑时选它
  "agent_kind": "WorkBuddy",

  // CLI 可执行文件路径。留空（null）= 在系统 PATH 中按默认名查找。
  // 2026-10-15 实测：WorkBuddy 品牌无独立 CLI，与 CodeBuddy 同用 codebuddy 命令
  // （npm install -g @tencent-ai/codebuddy-code），装好后无需配置此项。
  "cli_path": null,

  // CLI 参数模板。留空（null）= 用适配器内置模板，2026-10-15 实测校准后内置值为：
  //   WorkBuddy：--print "{prompt}" --model {model} {extra}（--expert 为非法参数，专家走 prompt 注入）
  //   CodeBuddy：-p "{prompt}" --model {model} --output-format text {extra}
  // 可用占位符：{prompt} 任务指令、{model} 模型标识、{expert} 专家 ID、
  //             {workspace} 工作目录、{extra} 附加参数
  "cli_arguments_template": null,

  // ==========================================================================
  // ② 工作空间（决定 Agent 在哪个目录下干活）
  //    生效优先级：单任务的 workspace 字段 > 本批默认 default_workspace > 全局默认 is_global_default
  //    全部落空时 = 程序当前工作目录
  // ==========================================================================

  "workspaces": [
    {
      // 命名空间名。任务文件里写 workspace: "web" 就会解析到下面这条的 path
      "name": "workagent",

      // 真实目录路径。预检时目录不存在会直接报错拦住启动
      "path": "E:/Src/CodeBak/WorkAgent",

      // 是否作为全局默认空间（所有未指定 workspace 的任务都在这里执行）
      "is_global_default": true
    }
  ],

  // 本批默认空间：填命名空间名或绝对路径。留空 = 走上面的全局默认
  "default_workspace": null,

  // ==========================================================================
  // ③ 账号池 × 候选模型（降级矩阵的两个维度）
  //    v1.12 变更：候选模型池与兜底模型池改为「挂在账号下」——每个账号配置自己
  //    独立的有序模型池，矩阵 = 各账号 × 自有池（不再是全局共享列表的笛卡尔积）。
  //    同一模型可在不同账号下配不同免费时段（如 A 账号 Hy4 0:00–8:00、B 账号 Hy4 全天）。
  // ==========================================================================

  // 账号池。凭据只存「引用」，明文一律不落盘、不写日志（PRD 第 8 章）
  "accounts": [
    {
      "id": "acc-1",

      // 界面与报告里显示的名字，随便起
      "display_name": "账号 1",

      // 凭据引用：告诉程序去哪拿这个账号的身份，形如
      //   profile:xxx（CLI 登录 profile 名）、env:XXX（环境变量名）、keychain:xxx（系统凭据库 key）
      // 这个值会以环境变量 BATCH_AGENT_ACCOUNT=<credential_ref> 的形式注入子进程
      "credential_ref": "profile:default",

      // 是否参与调度。停用的账号会被整个矩阵跳过；预检不通过的账号会被自动停用
      "enabled": true,

      // 【该账号自己的候选模型池（有序）】未配置（null/缺省）时回退到下面的全局 model_candidates
      "model_candidates": [
        {
          // 模型标识，原样传给 CLI 的 --model。账号内唯一；不同账号可同名（时段/单价各自独立）
          "name": "Hy4",

          // 免费时段（组合级）：null / 不写 = 全天可用。
          //   start / end —— "HH:mm:ss"；end < start 视为跨零点（如 22:00 → 次日 06:00）
          //   days       —— 星期过滤，语义是「时段覆盖日」：覆盖到的任一天命中即生效；
          //                 跨零点时段会同时看开始日与结束日（周日 22:00→周一 06:00 因覆盖周一而生效）。
          //                 写全部 7 天等价于不过滤。
          // 不在时段内 → 该「账号 × 模型」组合被「时段外跳过」：预期调度行为，
          // 不计任务失败、不触发切换告警、不影响误切换率统计
          "free_time_window": {
            "start": "00:00:00",
            "end": "08:00:00"
          },

          // 预估单次调用单价（元）。仅在 CLI 不返回用量/费用数据时用于估算口径。null = 不统计花费
          "estimated_unit_price": null,

          "note": "示例：账号 1 的 Hy4 仅 0:00–8:00 可用，其余时段被时段外跳过"
        },
        {
          "name": "model-b",
          "free_time_window": null,
          "estimated_unit_price": null,
          "note": "全天可用（不写 free_time_window 即全天）"
        }
      ],

      // 【该账号自己的兜底模型池（有序）】兜底触发时按「账号顺序 × 账号内兜底池顺序」选取；
      // 兜底模型不参与免费时段过滤；总开关与成本上限是全局的（见 ⑤）
      "fallback_models": [
        {
          "name": "paid-model",
          "estimated_unit_price": 0.5,
          "note": "示例：账号 1 的付费兜底模型"
        }
      ],

      // 备注：纯注释用，不参与任何逻辑
      "note": "把 credential_ref 换成你实际的 CLI 登录 profile / 环境变量名"
    },
    {
      "id": "acc-2",
      "display_name": "账号 2（备用）",
      "credential_ref": "profile:backup",
      "enabled": false,

      // 账号 2 的 Hy4 全天可用——与账号 1 的 Hy4（仅 0:00–8:00）互不影响，
      // 体现「同一模型在不同账号下可配不同时段」
      "model_candidates": [
        { "name": "Hy4", "free_time_window": null, "estimated_unit_price": null }
      ],
      "fallback_models": [],

      "note": "演示多账号降级：启用后账号 1 额度耗尽会自动切到这里；默认停用以免预检失败"
    }
  ],

  // 【向后兼容】全局共享候选列表：仅对「未配置自有 model_candidates」的账号生效。
  // 账号配置了自有池时，全局列表对该账号不生效。新配置建议直接把模型写进各账号
  "model_candidates": [],

  // 降级遍历顺序：
  //   ModelFirst （默认）—— 同一账号先轮完「该账号自己的」候选模型池，全耗尽再换下一个账号
  //   AccountFirst         —— 按模型名聚合：先把同一模型名在所有配置了它的账号上轮完，
  //                           再换下一个模型名（模型名按各账号候选池中的首次出现顺序）
  "degradation_strategy": "ModelFirst",

  // ==========================================================================
  // ④ 专家 / 专家团（可选）
  // ==========================================================================

  "expert": {
    // None = 不指定，走 CLI 默认智能体；Single = 单专家；Team = 专家团
    "kind": "None",

    // 专家 / 专家团 ID，会填进参数模板的 {expert} 占位符
    "id": null,

    // 显示名，仅用于任务文件里的 expert_used 字段与报告
    "display_name": null,

    // 角色描述。若实测发现 CLI 不支持专家参数，可退化为把这段文字拼进指令（prompt 注入）
    "role_prompt": null
  },

  // ==========================================================================
  // ⑤ 特殊模型兜底（默认关闭）
  //    v1.12 变更：兜底模型改为「挂在账号下」（accounts[].fallback_models，有序池），
  //    兜底触发时按「账号顺序 × 账号内兜底池顺序」选取第一个可用兜底组合。
  //    本节保留全局总开关与成本上限；fallback.model / fallback.estimated_unit_price 已废弃。
  //    触发时机：当前任务已经开跑过，但免费组合矩阵全部不可用（额度耗尽 / 时段外 / 冷却中），
  //    用付费模型把这个任务收尾。免费组合一个都没用过时不触发兜底，直接走等待或阻塞。
  // ==========================================================================

  "fallback": {
    "enabled": false,

    // 【已废弃（v1.12）】兜底模型改在 accounts[].fallback_models 里按账号配置；
    // 此字段仅为旧配置兼容保留解析，引擎不再消费
    "model": "",

    // 单个任务的兜底花费上限（元，全局）。估算单价超过它就不兜底这个任务
    "max_cost_per_task": 1.0,

    // 整批的兜底花费总上限（元，全局）。累计花超了就停用兜底并转为阻塞
    "max_cost_per_batch": 10.0,

    // 【已废弃（v1.12）】单价随账号下的兜底模型项配置
    // （accounts[].fallback_models[].estimated_unit_price）
    "estimated_unit_price": null
  },

  // ==========================================================================
  // ⑥ 重试 / 超时 / 上限
  //    注意这四个是不同层级的闸门，从窄到宽依次是：
  //    单次执行超时 → 单任务总时长 → 单任务总尝试次数 → 单批最长可等待
  // ==========================================================================

  // 普通失败（非限流、非额度、非危险操作）的重试次数。0 = 不重试直接判失败
  "max_retries_per_task": 2,

  // 临时限流（429 之类）的退避重试次数。退避期间重试的是「同一账号+同一模型」，
  // 用完仍失败才升级为「额度耗尽」去切换组合
  "rate_limit_backoff_retries": 3,

  // 退避起始秒数，指数增长：5 → 10 → 20 → 40…，单次上限 2 分钟
  "rate_limit_initial_backoff_seconds": 5,

  // 单次执行超时（分钟）。超了就判该次失败并保留已产生的部分输出
  "task_timeout_minutes": 10,

  // 单任务总尝试次数上限（切模型、切账号、退避重试都算一次）。防止任务无限重试
  "max_attempts_per_task": 10,

  // 单任务总时长上限（分钟）。从任务开始计时，含所有重试与切换
  "max_total_minutes_per_task": 60,

  // 最长可等待时长（分钟）。所有组合都不可用时，若最早恢复时间在此之内 → 进入「等待恢复」状态；
  // 超出 → 直接转「已阻塞」，等你补充额度/账号模型后手动续跑
  "max_wait_minutes": 60,

  // 默认冷却时长（分钟）。CLI 报错里解析不到额度重置时间时，按这个时长降级计算；
  // 冷却记录会落盘，重启后依然有效
  "default_cooldown_minutes": 60,

  // ==========================================================================
  // ⑦ 并发 / 续跑 / 失败即停
  // ==========================================================================

  // 同时执行的任务数。1 = 严格串行（默认，推荐）。
  // >1 会并发拉起多个 CLI 子进程，注意账号/额度是共享的，容易更快撞限流
  "concurrency": 1,

  // 强制重跑：忽略任务文件里的已完成状态，全部重跑。false = 已 done/failed 的跳过（续跑语义）
  "force_rerun": false,

  // 失败即停：某条任务重试用尽仍失败时，整批立刻转「已阻塞」，不再派发后续任务
  "stop_on_failure": false,

  // 终止时是否等当前任务跑完。false = 点「终止」立刻中断当前任务（已产生的输出保留为「部分输出」）
  // 注意：界面上「终止」和「跑完当前再停」是两个独立按钮，此项是给配置文件用的预留开关
  "terminate_after_current_task": false,

  // ==========================================================================
  // ⑧ 批处理结束后自动关机（默认关闭）
  //    关机在「结果 100% 落盘 + 报告写完之后」才执行，不会丢结果。
  // ==========================================================================

  "auto_shutdown": {
    "enabled": false,

    // true = 只有失败数为 0 才关机；false = 允许带着 failed 关机
    "only_when_zero_failure": false,

    // 可撤销倒计时（秒）。Windows 关机指令本身是立即执行的，
    // 该值用于界面提示与后续接可撤销关机时预留
    "countdown_seconds": 60
  },

  // ==========================================================================
  // ⑨ 交互自动应答与危险操作防护（无人值守的核心安全阀）
  //    机制：CLI 静默超过 stdin_idle_seconds 秒 = 认为它在等确认 →
  //          先查黑名单（命中 → 拒绝自动批准、杀掉进程、该任务判失败）
  //          再查白名单（命中 → 视为允许），都没命中 → 注入 default_answer 并记日志
  //    判定基于提示文本的关键词包含匹配，所以黑名单词条要覆盖你 CLI 的实际措辞。
  // ==========================================================================

  "auto_answer": {
    // 危险操作黑名单：命中即拒绝自动批准并中断该任务。默认已覆盖常见破坏性命令
    "dangerous_blacklist": [
      "rm -rf", "rm -r /", "del /f", "format ", "mkfs",
      "git push --force", "git push -f", "git reset --hard", "git clean -fd",
      "删除文件", "删除目录", "格式化", "强制推送",
      "修改系统配置", "注册表", "registry", "shutdown", "重启系统"
    ],

    // 白名单：命中即视为「这类确认你可以自己答」。白名单优先级高于黑名单，
    // 所以别把危险词写进白名单（如「删除文件」）。
    "allowed_whitelist": [
      "读取文件", "写入文件", "创建文件", "运行测试", "运行命令", "读取目录"
    ],

    // 默认应答内容，写入 CLI 的 stdin。多数 CLI 的确认默认项就是 y
    "default_answer": "y",

    // 静默多少秒判定为「在等输入」。设太小容易误判（模型思考时间长也会静默）
    "stdin_idle_seconds": 30
  },

  // ==========================================================================
  // ⑩ 每日积分领取
  //    登录页「一键领取所有账号的今日积分」：逐账号 自动切换身份 → 读领取前积分 →
  //    领取 → 读领取后积分，前后积分与变化量记录在配置目录 credits-claims.json（台账）
  //    与 credits-claim-*.md/json（报告）里；同账号每天只领一次（台账去重）。
  //    端点 2026-10-16 已抓包实测确认（POST + Bearer，服务端改动时只需改这里的路径）。
  // ==========================================================================

  "credits_claim": {
    // 总开关：false = 隐藏/禁用积分领取入口
    "enabled": true,

    // true = 每次批量任务开始前自动为所有启用账号领取（失败不阻断批处理）
    "auto_before_batch": false,

    "api_base": "https://www.codebuddy.cn",
    "balance_path": "/billing/meter/get-user-resource-summary",
    "claim_path": "/billing/meter/daily-checkin",

    // 单次 HTTP 调用超时（秒）
    "timeout_seconds": 20
  },

  // ==========================================================================
  // ⑪ 其它
  // ==========================================================================

  // 单任务结果写入任务文件的大小上限（KB）。超出截断并提示完整内容见运行日志
  "result_max_kb": 100,

  // 任务文件自动备份保留份数。每次启动前备份一次，更旧的自动删除；0 = 不备份
  "backup_retention": 5
}