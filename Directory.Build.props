<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- P0-12 / 治理方案阶段 1：存量警告已全量清零（no-incremental 全量重建实测 0 警告），
         警告转错误，防止新增警告悄悄入库。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- EnforceCodeStyleInBuild 使 .editorconfig 的 40+ 条规则在构建期执行（阶段 -1 / P0-15 落地）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- ARCH P-12 / A-10（2026-10-22）：CS1591 全仓抑制已偿还——四个 src 生产工程
         开启 GenerateDocumentationFile 且公共 API 全部补齐 XML 文档（测试工程不产出
         文档文件、CS1591 不触发，无需豁免）。该豁免已从治理方案 §4.7 逃逸阀台账退役。
         其余例外一律登记于治理方案 §4.7 台账并就近写明台账 ID 与到期日：CA1707 / CA2007 / CA1861
         （#4 / #5 / #6，仅测试项目，理由见各测试 csproj）、CA1720 / CA1859（#7 / #8，逐点
         [SuppressMessage]，写在其 Justification 上）、AVLN3001（#10，仅 Desktop，见其 csproj）。
         2026-10-21 P2-30 起由 EscapeValveHygieneTests 机器校验：四要素齐全 + 到期日未过期 + 代码与台账双向一致。 -->
  </PropertyGroup>

  <PropertyGroup Label="编码">
    <!-- 中文注释/中文界面文本需要 UTF-8 源码 -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <!-- ==================================================================
       快速迭代模式（AI / 本地开发用，CI 与正式构建零影响）：
       仅当环境变量 NEXYAW_FAST_BUILD=1 或 WORKAGENT_FAST_BUILD=1 时生效，
       用于「AI 改代码 → 快速确认能否编译」的迭代循环，不参与提交 / CI 门禁。
         · 跳过 Roslyn 分析器通道（csc 硬错误仍保留，只省分析器开销；
           含 EnforceCodeStyleInBuild 的代码样式强制一并关闭）
         · 退化为「警告不当错误」，避开全局 TreatWarningsAsErrors 把迭代打成红色
           （可空 / 样式等告警仍应在最终严格构建、提交前清除；本模式只加速定位真实错误）
         · 引用相关文件只带 .xml，不把 .pdb/.config 复制进 bin，削减巨石依赖闭包的拷贝 IO
       不设该变量时整块不生效，行为与治理基线完全一致（TreatWarningsAsErrors=true 等保留）。
       机制同源：NexYaw3D/Directory.Build.props 的 NEXYAW_FAST_BUILD；此处一并识别
       WORKAGENT_FAST_BUILD 以便跨仓库统一 SOP：
         会话开局 export <var>=1 → 迭代验证走 fast（只查真实错误）；
         提交 / 门禁前 unset → 跑严格 dotnet build 清可空与样式告警。
     ================================================================== -->
  <PropertyGroup Condition="'$(NEXYAW_FAST_BUILD)' == '1' or '$(WORKAGENT_FAST_BUILD)' == '1'">
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
