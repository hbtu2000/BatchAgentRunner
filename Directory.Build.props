<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- P0-12 / 治理方案阶段 1：存量警告已全量清零（no-incremental 全量重建实测 0 警告），
         警告转错误，防止新增警告悄悄入库。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- EnforceCodeStyleInBuild 使 .editorconfig 的 40+ 条规则在构建期执行（阶段 -1 / P0-15 落地）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- 逃逸阀台账 #3 / 到期日 2027-01-20 / 责任人 工程 —— CS1591（公共 API 缺文档注释）全仓抑制：
         补齐需数百处，与 P0-15「先 warning 不阻断」同期决策同源。
         其余例外一律登记于治理方案 §4.7 台账并就近写明台账 ID 与到期日：CA1707 / CA2007 / CA1861
         （#4 / #5 / #6，仅测试项目，理由见各测试 csproj）、CA1720 / CA1859（#7 / #8，逐点
         [SuppressMessage]，写在其 Justification 上）、AVLN3001（#10，仅 Desktop，见其 csproj）。
         2026-10-21 P2-30 起由 EscapeValveHygieneTests 机器校验：四要素齐全 + 到期日未过期 + 代码与台账双向一致。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="编码">
    <!-- 中文注释/中文界面文本需要 UTF-8 源码 -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

</Project>
