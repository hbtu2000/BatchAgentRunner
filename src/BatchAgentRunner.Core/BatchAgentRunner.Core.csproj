<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ARCH P-12 / A-10：产出 XML 文档文件，CS1591（公共 API 缺文档）随之真实生效，
         由 TreatWarningsAsErrors 把「无文档的新增公共 API」直接打成构建错误。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- P1-17：原 Microsoft.Extensions.Logging.Abstractions 依赖已移除——全仓 ILogger 使用 0 处，属无效依赖。 -->

</Project>
