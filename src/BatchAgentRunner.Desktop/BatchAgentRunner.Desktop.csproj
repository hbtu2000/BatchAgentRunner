<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 使用反射绑定：避免为每处 XAML 声明 x:DataType，降低维护成本 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- 逃逸阀台账 #10 / 到期日 2026-12-31 / 责任人 工程 —— AVLN3001（XAML 资源无公开无参构造、
         运行时加载器不可达）：ShutdownCountdownWindow 只由 EngineHost 以 ShutdownCountdownWindow(int)
         构造、从不经 XAML URI 加载，该告警对本窗口是假阳性；为消告警而补无参构造会平白扩大公开面。
         （2026-10-21 P2-30 复核：同批 AVLN5001 过时 API 与 CA2007 已偿还并从 NoWarn 移除。） -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\AppStyles.xaml" />
    <AvaloniaResource Include="Styles\GlobalStyles.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchAgentRunner.Core\BatchAgentRunner.Core.csproj" />
    <ProjectReference Include="..\BatchAgentRunner.Infrastructure\BatchAgentRunner.Infrastructure.csproj" />
    <ProjectReference Include="..\BatchAgentRunner.Agents\BatchAgentRunner.Agents.csproj" />
  </ItemGroup>
</Project>
