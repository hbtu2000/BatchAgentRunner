<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BatchAgentRunner.Desktop.ViewModels"
        xmlns:conv="using:BatchAgentRunner.Desktop.Converters"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="BatchAgentRunner.Desktop.Views.MainWindow"
        Icon="/Assets/app-icon.ico"
        Title="AI 批处理任务调度工具 · Batch Agent Runner"
        Width="1280" Height="880"
        Background="{DynamicResource BgAppBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- 单列布局：顶部状态条 + 顶部导航条 + 内容区（移除左侧 220 导航列，页面更宽） -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 顶部状态条 -->
        <Border Grid.Row="0" Padding="14,10"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                Background="{DynamicResource BgSurfaceBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="AI 批处理任务调度工具" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- 批级状态胶囊：点 + 文字（颜色随状态，双主题） -->
                <Border Grid.Column="1" Margin="16,0,0,0" Padding="10,4" CornerRadius="{DynamicResource RadiusPill}"
                        Background="{DynamicResource BgSurface2Brush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 conv:StatusDotHelper.BatchStatus="{Binding Status}" />
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding ConfigDirectory, StringFormat='配置目录：{0}'}" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" Text="BatchAgentRunner v1.0" />

                <!-- 主题切换 -->
                <Button Grid.Column="5" Content="{Binding Theme, StringFormat='主题：{0}'}"
                        Command="{Binding ToggleThemeCommand}"
                        VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- 顶部导航（原左侧导航上移，释放页面宽度） -->
        <Border Grid.Row="1" Padding="12,8"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                Background="{DynamicResource BgSurfaceBrush}">
            <WrapPanel Orientation="Horizontal">
                <Button Content="配置中心" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="confighub"
                        conv:StatusDotHelper.NavPage="confighub"
                        conv:StatusDotHelper.NavActivePage="{Binding ActivePage}" />
                <Button Content="执行监控" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="monitor"
                        conv:StatusDotHelper.NavPage="monitor"
                        conv:StatusDotHelper.NavActivePage="{Binding ActivePage}" />
                <Button Content="运行报告" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="report"
                        conv:StatusDotHelper.NavPage="report"
                        conv:StatusDotHelper.NavActivePage="{Binding ActivePage}" />
                <Button Content="变更概览" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="diff"
                        conv:StatusDotHelper.NavPage="diff"
                        conv:StatusDotHelper.NavActivePage="{Binding ActivePage}" />
                <Button Content="模板库" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="templates"
                        conv:StatusDotHelper.NavPage="templates"
                        conv:StatusDotHelper.NavActivePage="{Binding ActivePage}" />
            </WrapPanel>
        </Border>

        <!-- 内容区（占满整行，宽度更大） -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />

    </Grid>
</Window>
