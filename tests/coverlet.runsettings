<?xml version="1.0" encoding="utf-8"?>
<!--
  ARCH P-11 · 覆盖率采集配置（coverlet.collector，已在 Directory.Packages.props 中央管理版本）。

  只被 CI / 本地覆盖率门禁使用（scripts/ci/Assert-Coverage.ps1），不参与常规 dotnet test。

  关键约定：
    · Format=cobertura —— 门禁脚本按 Cobertura 的 line-rate 判阈值（与 coverlet 控制台表同源）。
    · SkipAutoProps=true —— 自动属性（get/set）不计入分母，避免"为了覆盖率给自动属性写测试"。
    · 不在此处做 Exclude（coverlet.collector v6 对 [Asm*]* 通配式会误伤、导致整份 0 采集）；
      门禁脚本只评估生产程序集（Core/Infrastructure/Agents/Desktop），测试工程与 Avalonia 等
      第三方程序集不在阈值表内，自然不参与分母。
    · 采集范围 = 快跑 bucket（排除 E2E/Usability/Process），保证门禁可重复、不受慢机器/真实进程影响。
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
