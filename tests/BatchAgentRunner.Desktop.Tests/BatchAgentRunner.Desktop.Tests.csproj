<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- P0-12 / P2-20 / P2-30：同主测试项目的测试项目规则豁免（逐条登记于治理方案 §4.7 逃逸阀台账）：
         逃逸阀台账 #4 / 到期日 2027-01-20 / 责任人 工程 —— CA1707（下划线 + 中文名是本仓测试命名约定）；
         逃逸阀台账 #5 / 到期日 2027-01-20 / 责任人 工程 —— CA2007（与 xUnit 自家 xUnit1030 冲突，
         xUnit 建议测试方法省略 ConfigureAwait）；
         逃逸阀台账 #6 / 到期日 2027-01-20 / 责任人 工程 —— CA1861（测试期望值数组一次性使用，
         提 static readonly 损害可读性且无性能收益）。 -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- P1-19：xunit v3（Avalonia.Headless.XUnit 面向 v3；主测试项目仍用 v2） -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Desktop 依赖 Avalonia；冒烟测试只触碰其纯 UI 无关单元（值转换器），不创建窗口/不启动 Application -->
    <PackageReference Include="Avalonia" />
    <!-- P1-19：Avalonia headless 测试基座（真实 headless Application + UI 线程消息循环），用于视图构造与线程收敛契约测试 -->
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- P0-17：补引用——测试项目首次引用 Desktop 程序集，使其可被测试锁定（原为结构性不可测） -->
    <ProjectReference Include="..\..\src\BatchAgentRunner.Desktop\BatchAgentRunner.Desktop.csproj" />
  </ItemGroup>

</Project>
